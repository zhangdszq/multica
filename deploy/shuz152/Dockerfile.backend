# Build from the repository root: binaries and SQL must share one revision.
FROM golang:1.26-alpine AS builder
WORKDIR /src/server
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOMAXPROCS=2 GOMEMLIMIT=1GiB
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
ARG COMMIT=unknown
ARG VERSION=dev
ENV CGO_ENABLED=0
RUN go build -p 2 -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" -o /out/server ./cmd/server && \
    go build -p 2 -ldflags "-s -w" -o /out/migrate ./cmd/migrate

FROM ghcr.io/multica-ai/multica-backend:v0.4.44
COPY --from=builder /out/server /app/server
COPY --from=builder /out/migrate /app/migrate
RUN rm -rf /app/migrations
COPY --from=builder /src/server/migrations/ /app/migrations/
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
